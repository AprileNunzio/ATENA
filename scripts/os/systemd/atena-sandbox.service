[Unit]
Description=Atena Sandbox Broker (esecuzione isolata del codice generato)
After=docker.service
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/opt/Atena
Environment=PYTHONPATH=/opt/Atena
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m sandbox_broker.main
RuntimeDirectory=atena/sandbox
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
StateDirectory=atena/sandbox
Restart=always
RestartSec=3
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
