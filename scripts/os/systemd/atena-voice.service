[Unit]
Description=Atena OS Voice (sintesi vocale neurale Kokoro)
After=atena-supervisor.service
PartOf=atena-supervisor.service

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/atena-voice/kokoro/venv/bin/python /opt/Atena/installer_wizard/features/voices/service.py
Restart=always
RestartSec=5
MemoryMax=2G
Nice=-3
CPUWeight=300

[Install]
WantedBy=multi-user.target
