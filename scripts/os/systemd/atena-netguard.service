[Unit]
Description=Atena Netguard (analisi del traffico di rete e rilevamento degli attacchi)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
EnvironmentFile=-/etc/atena/netguard.env
ExecStart=/opt/atena-native/bin/atena-netguard capture $NETGUARD_ARGS --socket /run/atena/netguard/netguard.sock
Restart=always
RestartSec=5
DynamicUser=yes
RuntimeDirectory=atena/netguard
RuntimeDirectoryMode=0750
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_PACKET AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
MemoryMax=512M
CPUQuota=80%

[Install]
WantedBy=multi-user.target
