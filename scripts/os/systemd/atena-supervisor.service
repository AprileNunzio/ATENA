[Unit]
Description=Atena OS Supervisor (installazione, avvio, auto-riparazione, aggiornamenti)
Documentation=https://github.com/AprileNunzio/ATENA
After=network-online.target docker.service
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5
OnFailure=atena-rollback.service

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
Environment=ATENA_DIR=/opt/Atena
ExecStartPre=/bin/bash /opt/Atena/scripts/os/prestart.sh
ExecStart=/opt/Atena/installer_wizard/venv/bin/python /opt/Atena/installer_wizard/backend/atena_launch.py
Restart=always
RestartSec=3
TimeoutStartSec=900
KillMode=mixed
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
